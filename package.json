{
  "name": "payfuzz",
  "version": "0.1.0",
  "description": "A payment-logic fuzzer and attack simulator that runs in your CI — never touches real money, real keys, or your wallet.",
  "keywords": [
    "payment",
    "security",
    "fuzzing",
    "fintech",
    "stripe",
    "wallet",
    "ci",
    "github-action",
    "static-analysis"
  ],
  "license": "MIT",
  "author": "PayFuzz",
  "homepage": "https://github.com/jalaljavadi166-netizen/payfuzz#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jalaljavadi166-netizen/payfuzz.git"
  },
  "bugs": {
    "url": "https://github.com/jalaljavadi166-netizen/payfuzz/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "payfuzz": "dist/cli.js"
  },
  "files": [
    "dist",
    "action.yml",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0",
    "commander": "^12.1.0",
    "ts-morph": "^24.0.0",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@vitest/coverage-v8": "^2.1.3",
    "prettier": "^3.3.3",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
